# ------------------------------------------------------------------
# Hookbox environment
# Copy to .env and adjust. Defaults are safe for local development.
# ------------------------------------------------------------------

# --- Database ------------------------------------------------------
# Local dev (zero-config, no docker): SQLite
DATABASE_URL="file:./dev.db"
# Self-host with docker compose (PostgreSQL): uncomment and remove the SQLite line above
# DATABASE_URL="postgresql://hookbox:hookbox@localhost:5432/hookbox?schema=public"

# --- App -----------------------------------------------------------
APP_URL="http://localhost:3000"

# --- Capture limits ------------------------------------------------
# Max request body size in bytes (1 MB default)
BODY_LIMIT_BYTES="1000000"
# Max total header bytes (64 KB default)
HEADERS_LIMIT_BYTES="65536"
# Max requests accepted per inbox per minute (simple in-memory rate limit)
RATE_LIMIT_PER_MINUTE="120"
# Anonymous inboxes expire after this many hours
INBOX_TTL_HOURS="24"